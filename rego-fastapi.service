[Unit] 
Description=Example FastAPI backend 
After=network.target 

[Service] 
Type=exec 
User=fastapi 
Group=fastapi 
WorkingDirectory=/opt/rego-fastapi 
ExecStart=/opt/rego-fastapi/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 
Restart=on-failure 
RestartSec=3 

[Install] 
WantedBy=multi-user.target
